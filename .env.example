# Copy to .env.local and edit. Only the variables below are read by this app.

# Public origin used for metadataBase, robots.txt and sitemap.xml.
# MUST include the scheme: "https://example.com", not "example.com" — a
# schemeless value makes every <loc> in sitemap.xml relative, which search
# engines discard silently.
# Deliberately NOT prefixed NEXT_PUBLIC_: those are inlined as string literals
# at build time and can never be changed by the runtime environment. Unprefixed
# vars are read from process.env at request time in server code.
SITE_URL=https://www.xyrus10.dev

# Path to the SQLite database file.
# Unset = ./data/sqlite.db relative to the process cwd (the repo root in dev).
# Read by BOTH src/lib/db/index.ts and drizzle.config.ts, so `pnpm db:push` and
# `pnpm db:studio` always act on the same file the app opens.
# The whole ./data directory is gitignored — it holds the admin password hash.
DATABASE_PATH=data/sqlite.db

# Optional read cache for the public pages (src/lib/redis.ts).
# Enabled only when this is exactly the string "true". If Redis is unreachable
# the app logs once and serves uncached rather than failing.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Set to "true" ONLY when this app sits behind a reverse proxy you control that
# rewrites X-Forwarded-For. Left unset, the login rate limiter ignores the
# header entirely, because a client can forge it and bypass the limiter.
TRUST_PROXY=false

# NODE_ENV is read by src/lib/auth/auth.ts to mark the session cookie Secure
# (HTTPS only) in production. Do NOT set it here — Next.js manages it, and
# overriding it in a .env file causes build/runtime warnings.
