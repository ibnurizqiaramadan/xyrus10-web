# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# database (contains the admin password hash - never commit).
# Ignoring the directory, not the filenames, so the -wal/-shm sidecars and any
# backup dropped next to it are covered without adding a line each time.
/data/

# runtime uploads
/public/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/.gemini/
.playwright-mcp
# local screenshots / scratch
/image.png
/*-1440.png
/*-375.png
